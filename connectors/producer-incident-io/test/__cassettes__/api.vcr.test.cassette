            "status": 200,
            "body": "{\"incident_updates\":[{\"created_at\":\"2025-03-24T14:31:00.235Z\",\"id\":\"01JQ490R8T6AFZ2T12RP72RTND\",\"incident_id\":\"01JQ48RSNJ4P4PERM8PEVNE923\",\"new_incident_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2025-03-24T14:26:39.562Z\",\"id\":\"01JQ48RSNJ2YTRYNRQHBSVJ7W8\",\"incident_id\":\"01JQ48RSNJ4P4PERM8PEVNE923\",\"new_incident_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JQ48RSA6MQPGK2HAVJ07JF78\",\"title\":\"Kubelet is running at capacity.\"}}}],\"pagination_meta\":{\"after\":\"01JQ48RSNJ2YTRYNRQHBSVJ7W8\",\"page_size\":250}}",
