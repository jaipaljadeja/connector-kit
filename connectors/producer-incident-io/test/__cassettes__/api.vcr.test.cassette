            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01JPCVGJ8E9CETZE6KAE2VD0SY\",\"new_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JPB5WQFN066Q2235DFHRVBC2\",\"title\":\"Pod is crash looping.\"}}}},\"created_at\":\"2025-03-15T12:12:26.488Z\",\"id\":\"01JPCVGJFR83EJE6GQWC37D1R9\",\"incident_id\":\"01JPCVGJ8ENC4GPE4A1J60888G\",\"occurred_at\":\"2025-03-15T12:12:26.294Z\",\"title\":\"Incident reported in triage by Grafana alert\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JPCVJ2W73ZCABZ8JMA1EHBWN\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"previous_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-03-15T12:13:16.227Z\",\"id\":\"01JPCVJ3234BMSGTBTHB4C6XDS\",\"incident_id\":\"01JPCVGJ8ENC4GPE4A1J60888G\",\"occurred_at\":\"2025-03-15T12:13:16.139Z\",\"title\":\"Incident accepted\",\"type\":\"incident_update\"},{\"content\":{\"incident_rename\":{\"new_name\":\"Paradex node is crashing\",\"previous_name\":\"Pod is crash looping.\",\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-03-15T12:13:16.766Z\",\"id\":\"01JPCVJ3JY4FVED0N7GS3XG51Z\",\"incident_id\":\"01JPCVGJ8ENC4GPE4A1J60888G\",\"occurred_at\":\"2025-03-15T12:13:16.22Z\",\"title\":\"Incident renamed\",\"type\":\"incident_rename\"},{\"content\":{\"incident_update\":{\"id\":\"01JPG2ZEJVD565ANZB0VRQ9CNE\",\"message\":\"We nuked it\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"new_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"previous_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"previous_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\