          "response": {
            "status": 200,
            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01JKZ1NPXDHGA8ZJ7T77V6QNJH\",\"new_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JKZ1NPQBYCZQ564ZZKH17PF9\",\"title\":\"Ingestion stopped (ethereum-mainnet)\"}}}},\"created_at\":\"2025-02-13T06:59:20.822Z\",\"id\":\"01JKZ1NQ3PTMD36266A8AJQMX8\",\"incident_id\":\"01JKZ1NPXD64FBJACK92HQQTRK\",\"occurred_at\":\"2025-02-13T06:59:20.685Z\",\"title\":\"Incident reported in triage by Grafana alert\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JKZ28P0FD89C8XCJPWFR26E6\",\"message\":\"null\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"previous_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-02-13T07:09:42.507Z\",\"id\":\"01JKZ28P7B8XP6E1RBHHX9QQ5E\",\"incident_id\":\"01JKZ1NPXD64FBJACK92HQQTRK\",\"occurred_at\":\"2025-02-13T07:09:42.405Z\",\"title\":\"Incident accepted\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JKZ29W60ABV9GT8TY725RY3J\",\"message\":\"Beacon chain disk was full.\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"new_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"previous_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"previous_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-02-13T07:10:21.71Z\",\"id\":\"01JKZ29WGC23Y40BYCX9EN565Y\",\"incident_id\":\"01JKZ1NPXD64FBJACK92HQQTRK\",\"occurred_at\":\"2025-02-13T07:10:21.552Z\",\"title\":\"Incident resolved and closed\",\"type\":\"incident_update\"},{\"content\":{\"summary_update\":{\"new_summary\":\"The beacon chain node was full. The disk usage alert for some reason is not there anymore.\",\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-02-13T07:10:21.664Z\",\"id\":\"01JKZ29WF17MVKYZTNKNCR72BB\",\"incident_id\":\"01JKZ1NPXD64FBJACK92HQQTRK\",\"occurred_at\":\"2025-02-13T07:10:21.65Z\",\"title\":\"Summary updated\",\"type\":\"summary_update\"},{\"content\":{\"role_update\":{\"new_assignee\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"},\"role\":{\"created_at\":\"2024-10-01T17:03:30.084Z\",\"description\":\"The person currently coordinating the incident, tasked with driving it to resolution and ensuring clear internal and external communication with stakeholders and customers.\",\"id\":\"01J94GJXNJ14TNN5Y1W0SXX727\",\"instructions\":\"- Make sure it’s clear who is doing what, and that people are working together effectively\\n- Ensure everybody has what they need, and any blockers are flagged quickly\\n- Provide regular, clear updates for stakeholders to let them know what’s happening\",\"name\":\"Incident Lead\",\"role_type\":\"lead\",\"shortform\":\"lead\",\"updated_at\":\"2024-10-01T17:03:30.084Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-02-13T07:10:22.138Z\",\"id\":\"01JKZ29WXVR41BV9NS88HW3AXQ\",\"incident_id\":\"01JKZ1NPXD64FBJACK92HQQTRK\",\"occurred_at\":\"2025-02-13T07:10:21.658Z\",\"title\":\"Francesco became the Incident Lead\",\"type\":\"role_update\"}],\"pagination_meta\":{\"page_size\":250}}",
