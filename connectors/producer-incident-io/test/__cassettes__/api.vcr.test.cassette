            "status": 200,
            "body": "{\"incident_updates\":[{\"created_at\":\"2024-10-02T10:07:50.534Z\",\"id\":\"01J96B6HN0RRH69WRG48EPF9F1\",\"incident_id\":\"01J96AZVCDNBG39T7JYP1WJW4P\",\"new_incident_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.994Z\",\"description\":\"Issues causing very high impact to customers. Immediate response is required. Examples include a full outage, or a data breach.\",\"id\":\"01J94GJXNJ8NR7Z8NFNJWY3JF9\",\"name\":\"Critical\",\"rank\":2,\"updated_at\":\"2024-10-01T17:03:29.994Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2024-10-02T10:05:48.088Z\",\"id\":\"01J96B2T40GX4JH1KTDHRB85KG\",\"incident_id\":\"01J96AZVCDNBG39T7JYP1WJW4P\",\"new_incident_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.039Z\",\"description\":\"Something has gone wrong, and we know why. We're in the process of fixing it.\",\"id\":\"01J94GJXNJ92K7SRTCH1QV7EQX\",\"name\":\"Fixing\",\"rank\":2,\"updated_at\":\"2024-10-01T17:03:30.039Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.994Z\",\"description\":\"Issues causing very high impact to customers. Immediate response is required. Examples include a full outage, or a data breach.\",\"id\":\"01J94GJXNJ8NR7Z8NFNJWY3JF9\",\"name\":\"Critical\",\"rank\":2,\"updated_at\":\"2024-10-01T17:03:29.994Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2024-10-02T10:04:11.064Z\",\"id\":\"01J96AZVCDEXWDEAY2YWA2M4H9\",\"incident_id\":\"01J96AZVCDNBG3