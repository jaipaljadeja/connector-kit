            "status": 200,
            "body": "{\"incident_updates\":[{\"created_at\":\"2025-01-29T03:56:55.606Z\",\"id\":\"01JJR38X9HCY5W0FJJEMCW17VS\",\"incident_id\":\"01JJR29FHRJTJZJ3TD68KKZAKX\",\"message\":\"I increased the size of the volumes.\",\"new_incident_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2025-01-29T03:41:02.813Z\",\"id\":\"01JJR2BTWA229M1M9EMJ5VZH0D\",\"incident_id\":\"01JJR29FHRJTJZJ3TD68KKZAKX\",\"new_incident_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2025-01-29T03:39:45.619Z\",\"id\":\"01JJR29FHRQWPPS7F4596XTCSP\",\"incident_id\":\"01JJR29FHRJTJZJ3TD68KKZAKX\",\"new_incident_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JJP69S7PKA4MW8CVVNXCKWPK\",\"title\":\"KubePersistentVolumeFillingUp\"}}}],\"pagination_meta\":{\"after\":\"01JJR29FHRQWPPS7F4596XTCSP\",\"page_size\":250}}",
