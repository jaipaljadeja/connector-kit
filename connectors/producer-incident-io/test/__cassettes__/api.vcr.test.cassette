            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01J96AZVCDEXWDEAY2YWA2M4H9\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2024-10-02T10:04:11.729Z\",\"id\":\"01J96AZW2HH8H2RK2XGHH7TX4A\",\"incident_id\":\"01J96AZVCDNBG39T7JYP1WJW4P\",\"occurred_at\":\"2024-10-02T10:04:11.728Z\",\"title\":\"Incident reported by Francesco\",\"type\":\"incident_update\"},{\"content\":{\"role_update\":{\"new_assignee\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"},\"role\":{\"created_at\":\"2024-10-01T17:03:30.084Z\",\"description\":\"The person currently coordinating the incident, tasked with driving it to resolution and ensuring clear internal and external communication with stakeholders and customers.\",\"id\":\"01J94GJXNJ14TNN5Y1W0SXX727\",\"instructions\":\"- Make sure it’s clear who is doing what, and that people are working together effectively\\n- Ensure everybody has what they need, and any blockers are flagged quickly\\n- Provide regular, clear updates for stakeholders to let them know what’s happening\