            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01JRN1MB0CGDB61WJ93BHKNCPH\",\"new_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JRN1MATCB9C580ZQDK7GAXET\",\"title\":\"Ingestion stopped (dna-starknet-mainnet)\"}}}},\"created_at\":\"2025-04-12T13:04:40.708Z\",\"id\":\"01JRN1MB84G0YCWJW6R9YQ6VF1\",\"incident_id\":\"01JRN1MB0CHKXBA7WBTJAZS4PY\",\"occurred_at\":\"2025-04-12T13:04:40.527Z\",\"title\":\"Incident reported in triage by Grafana alert\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JRN1MWCCXXDQ4JBR3GT9AWMF\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"previous_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-04-12T13:04:58.425Z\",\"id\":\"01JRN1MWHTD9GF9XR7831E1YX2\",\"incident_id\":\"01JRN1MB0CHK