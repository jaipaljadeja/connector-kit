            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01JKZ6PV7ZMCKNVDYCS1M4T33W\",\"new_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JKZ6PV03C5YG8Z3A5D0CHBGN\",\"title\":\"Ingestion stopped (starknet-mainnet)\"}}}},\"created_at\":\"2025-02-13T08:27:21.018Z\",\"id\":\"01JKZ6PVHT4NCHNCSDN5MKXBMA\",\"incident_id\":\"01JKZ6PV7ZG70R7H0X1JV7SMA4\",\"occurred_at\":\"2025-02-13T08:27:20.869Z\",\"title\":\"Incident reported in triage by Grafana alert\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JKZ6QZS15FP0FS08MQHC48GF\",\"message\":\"null\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"previous_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-02-13T08:27:58.293Z\",\"id\":\"01JKZ6QZYNCKZ7GAVS7D6V1XBT\",\"incident_id