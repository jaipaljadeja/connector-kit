          "response": {
            "status": 200,
            "body": "{\"incident_updates\":[{\"created_at\":\"2025-02-02T00:27:54.171Z\",\"id\":\"01JK20X1TA9122MBMB40PZCY3Y\",\"incident_id\":\"01JJR29EPK6QZGQ03S4BC4GM66\",\"new_incident_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2025-01-29T03:57:48.944Z\",\"id\":\"01JJR3AHE59AN33C7XX4RZKZYM\",\"incident_id\":\"01JJR29EPK6QZGQ03S4BC4GM66\",\"message\":\"The etcd cluster entered a naughty state. Deploying a new cluster to switch apisix to it later.\",\"new_incident_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.039Z\",\"description\":\"Something has gone wrong, and we know why. We're in the process of fixing it.\",\"id\":\"01J94GJXNJ92K7SRTCH1QV7EQX\",\"name\":\"Fixing\",\"rank\":2,\"updated_at\":\"2024-10-01T17:03:30.039Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2025-01-29T03:42:55.032Z\",\"id\":\"01JJR2F8F639Q7TQWEQ383B0RF\",\"incident_id\":\"01JJR29EPK6QZGQ03S4BC4GM66\",\"new_incident_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2025-01-29T03:39:44.744Z\",\"id\":\"01JJR29EPKV0YN0MAMN7P9EJH6\",\"incident_id\":\"01JJR29EPK6QZGQ03S4BC4GM66\",\"new_incident_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JJPQVYHHQVC9RQGKD0GP1SF2\",\"title\":\"KubePodCrashLooping\"}}}],\"pagination_meta\":{\"after\":\"01JJR29EPKV0YN0MAMN7P9EJH6\",\"page_size\":250}}",
