        "{\"body\":\"\",\"headers\":{\"accept\":\"application/json\"},\"method\":\"GET\",\"url\":\"https://api.incident.io/v1/severities\"}": {
          "request": {
            "method": "GET",
            "url": "https://api.incident.io/v1/severities",
            "headers": {
              "accept": "application/json"
            }
          },
          "response": {
            "status": 200,
            "body": "{\"severities\":[{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},{\"created_at\":\"2024-10-01T17:03:29.994Z\",\"description\":\"Issues causing very high impact to customers. Immediate response is required. Examples include a full outage, or a data breach.\",\"id\":\"01J94GJXNJ8NR7Z8NFNJWY3JF9\",\"name\":\"Critical\",\"rank\":2,\"updated_at\":\"2024-10-01T17:03:29.994Z\"}]}",
            "headers": {
              "alt-svc": "h3=\":443\"; ma=2592000,h3-29=\":443\"; ma=2592000",
