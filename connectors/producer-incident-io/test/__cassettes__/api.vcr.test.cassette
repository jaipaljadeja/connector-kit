            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01JQRE500PHH6AJ20Y21XN0EYY\",\"new_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JQRE4ZSDZX12HAC27RRCNNBM\",\"title\":\"DNA V1 ingestion stopped (starknet-dna-mainnet-kulipa)\"}}}},\"created_at\":\"2025-04-01T10:25:31.309Z\",\"id\":\"01JQRE50NDH90FHT5N8DPZ5QQ7\",\"incident_id\":\"01JQRE500PVGYYF9CQ15MKDX42\",\"occurred_at\":\"2025-04-01T10:25:31.084Z\",\"title\":\"Incident reported in triage by Grafana alert\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JQRE6EN3PNKJHBXST8A5S3C9\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"previous_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-04-01T10:26:18.592Z\",\"id\":\"01JQRE6EV0PFWZAQ02WAM9GBQA\",\"incident_id\":