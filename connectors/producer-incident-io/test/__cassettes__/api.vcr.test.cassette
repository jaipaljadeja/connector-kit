          "response": {
            "status": 200,
            "body": "{\"incident_updates\":[{\"created_at\":\"2024-10-17T12:20:28.847Z\",\"id\":\"01JAD6R6B44NVRGPC0KXC9H2TW\",\"incident_id\":\"01JAA6XVQTR5MDCJ45DV53R87B\",\"new_incident_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2024-10-17T12:17:28.826Z\",\"id\":\"01JAD6JPM9EXJ6XEQM0F7DGZHN\",\"incident_id\":\"01JAA6XVQTR5MDCJ45DV53R87B\",\"new_incident_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.039Z\",\"description\":\"Something has gone wrong, and we know why. We're in the process of fixing it.\",\"id\":\"01J94GJXNJ92K7SRTCH1QV7EQX\",\"name\":\"Fixing\",\"rank\":2,\"updated_at\":\"2024-10-01T17:03:30.039Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2024-10-17T12:17:16.228Z\",\"id\":\"01JAD6JAA74ZB0WK5DFCEQGBGX\",\"incident_id\":\"01JAA6XVQTR5MDCJ45DV53R87B\",\"new_incident_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2024-10-16T08:25:51.135Z\",\"id\":\"01JAA6XVQTGKWGTB3QN70Y0RV0\",\"incident_id\":\"01JAA6XVQTR5MDCJ45DV53R87B\",\"new_incident_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JAA6XVJFASWAZAFD4VZWZC57\",\"title\":\"KubePersistentVolumeFillingUp\"}}}],\"pagination_meta\":{\"after\":\"01JAA6XVQTGKWGTB3QN70Y0RV0\",\"page_size\":250}}",
