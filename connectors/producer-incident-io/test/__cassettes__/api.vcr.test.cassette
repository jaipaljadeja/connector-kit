            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01M4NKCWS8WQ1AAPXYDT32H8V2\",\"new_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01M4NKCWK3F5XKK3VPACHXPQFG\",\"title\":\"Triggered: dexscreener > ekubo > indexing\"}}}},\"created_at\":\"2026-10-11T13:45:51.335Z\",\"id\":\"01M4NKCWZ8V3JA1R58ADKBT3NT\",\"incident_id\":\"01M4NKCWS8VKT0C9GNMHVAV34D\",\"occurred_at\":\"2026-10-11T13:45:51.204Z\",\"title\":\"Incident reported in triage by HTTP alert\",\"type\":\"incident_update\"},{\"content\":{\"incident_rename\":{\"new_name\":\"dexscreener ekubo indexing at 0 below threshold\",\"previous_name\":\"Triggered: dexscreener > ekubo > indexing\",\"updater\":{}}},\"created_at\":\"2026-10-11T13:45:52.764Z\",\"id\":\"01M4NKCYBWJKPN2MWJ1KX2D0EG\",\"incident_id\":\"01M4NKCWS8VKT0C9GNMHVAV34D\",\"occurred_at\":\"2026-10-11T13:45:52.759Z\",\"title\":\"Incident renamed\",\"type\":\"incident_rename\"},{\"content\":{\"incident_update\":{\"id\":\"01M4NKEW0Z4QG2Z29RGVTQAEGY\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"previous_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"des