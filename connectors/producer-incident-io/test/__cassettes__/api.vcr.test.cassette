          "response": {
            "status": 200,
            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01JJR29FHRQWPPS7F4596XTCSP\",\"new_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JJP69S7PKA4MW8CVVNXCKWPK\",\"title\":\"KubePersistentVolumeFillingUp\"}}}},\"created_at\":\"2025-01-29T03:39:45.847Z\",\"id\":\"01JJR29FSRFMND9E0XGK387ZPS\",\"incident_id\":\"01JJR29FHRJTJZJ3TD68KKZAKX\",\"occurred_at\":\"2025-01-29T03:39:45.619Z\",\"title\":\"Incident reported in triage by Grafana alert\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JJR2BTWA229M1M9EMJ5VZH0D\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"previous_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-01-29T03:41:02.889Z\",\"id\":\"01JJR2BV190P4W0DK238XMK60G\",\"incident_id\":\"01JJR29FHRJTJZJ3TD68KKZAKX\",\"occurred_at\":\"2025-01-29T03:41:02.813Z\",\"title\":\"Incident accepted\",\"type\":\"incident_update\"},{\"content\":{\"role_update\":{\"new_assignee\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"},\"role\":{\"created_at\":\"2024-10-01T17:03:30.084Z\",\"description\":\"The person currently coordinating the incident, tasked with driving it to resolution and ensuring clear internal and external communication with stakeholders and customers.\",\"id\":\"01J94GJXNJ14TNN5Y1W0SXX727\",\"instructions\":\"- Make sure it’s clear who is doing what, and that people are working together effectively\\n- Ensure everybody has what they need, and any blockers are flagged quickly\\n- Provide regular, clear updates for stakeholders to let them know what’s happening\",\"name\":\"Incident Lead\",\"role_type\":\"lead\",\"shortform\":\"lead\",\"updated_at\":\"2024-10-01T17:03:30.084Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-01-29T03:55:14.861Z\",\"id\":\"01JJR35V1DKVZBA9GT0QV9K756\",\"incident_id\":\"01JJR29FHRJTJZJ3TD68KKZAKX\",\"occurred_at\":\"2025-01-29T03:55:14.856Z\",\"title\":\"Francesco became the Incident Lead\",\"type\":\"role_update\"},{\"content\":{\"summary_update\":{\"new_summary\":\"Volumes for some DNA v1 servers on the app cluster are filling up.\",\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-01-29T03:55:53.314Z\",\"id\":\"01JJR370K36Y23YVD32308A43B\",\"incident_id\":\"01JJR29FHRJTJZJ3TD68KKZAKX\",\"occurred_at\":\"2025-01-29T03:55:53.31Z\",\"title\":\"Summary updated\",\"type\":\"summary_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JJR38X9HCY5W0FJJEMCW17VS\",\"message\":\"I increased the size of the volumes.\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"new_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"previous_severity\":{\"created_at\":\"2024-10-01T17:03:29.988Z\",\"description\":\"Issues causing significant impact. Immediate response is usually required. We might have some workarounds that mitigate the impact on customers. Examples include an important sub-system failing.\",\"id\":\"01J94GJXNJ81FT9G5KGVEP8N6G\",\"name\":\"Major\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:29.988Z\"},\"previous_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-01-29T03:56:55.701Z\",\"id\":\"01JJR38XGNEK788Q1K07D216KX\",\"incident_id\":\"01JJR29FHRJTJZJ3TD68KKZAKX\",\"occurred_at\":\"2025-01-29T03:56:55.606Z\",\"title\":\"Incident resolved and closed\",\"type\":\"incident_update\"}],\"pagination_meta\":{\"page_size\":250}}",
