          "response": {
            "status": 200,
            "body": "{\"incident_activity_log_entries\":[{\"content\":{\"incident_update\":{\"id\":\"01JJR29EPKV0YN0MAMN7P9EJH6\",\"new_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"alert\":{\"id\":\"01JJPQVYHHQVC9RQGKD0GP1SF2\",\"title\":\"KubePodCrashLooping\"}}}},\"created_at\":\"2025-01-29T03:39:44.904Z\",\"id\":\"01JJR29EW8Q610YTG80TERRYEM\",\"incident_id\":\"01JJR29EPK6QZGQ03S4BC4GM66\",\"occurred_at\":\"2025-01-29T03:39:44.744Z\",\"title\":\"Incident reported in triage by Grafana alert\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JJR2F8F639Q7TQWEQ383B0RF\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"previous_status\":{\"category\":\"triage\",\"created_at\":\"2024-10-01T17:03:30.017Z\",\"description\":\"\",\"id\":\"01J94GJXNJW4NQ4P1B1JN84VPF\",\"name\":\"Triage\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:30.017Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-01-29T03:42:55.101Z\",\"id\":\"01JJR2F8KXE0MGFAP1RZJTMXNW\",\"incident_id\":\"01JJR29EPK6QZGQ03S4BC4GM66\",\"occurred_at\":\"2025-01-29T03:42:55.032Z\",\"title\":\"Incident accepted\",\"type\":\"incident_update\"},{\"content\":{\"incident_rename\":{\"new_name\":\"Apisix Etcd Cluster crashing\",\"previous_name\":\"KubePodCrashLooping\",\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-01-29T03:42:55.639Z\",\"id\":\"01JJR2F94QAMJM0HD1FQTVV27G\",\"incident_id\":\"01JJR29EPK6QZGQ03S4BC4GM66\",\"occurred_at\":\"2025-01-29T03:42:55.104Z\",\"title\":\"Incident renamed\",\"type\":\"incident_rename\"},{\"content\":{\"incident_update\":{\"id\":\"01JJR3AHE59AN33C7XX4RZKZYM\",\"message\":\"The etcd cluster entered a naughty state. Deploying a new cluster to switch apisix to it later.\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"new_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.039Z\",\"description\":\"Something has gone wrong, and we know why. We're in the process of fixing it.\",\"id\":\"01J94GJXNJ92K7SRTCH1QV7EQX\",\"name\":\"Fixing\",\"rank\":2,\"updated_at\":\"2024-10-01T17:03:30.039Z\"},\"next_update_in_minutes\":1440,\"previous_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"previous_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}}},\"created_at\":\"2025-01-29T03:57:49.014Z\",\"id\":\"01JJR3AHJPQ5HGG9CS6XJ4NXD6\",\"incident_id\":\"01JJR29EPK6QZGQ03S4BC4GM66\",\"occurred_at\":\"2025-01-29T03:57:48.944Z\",\"title\":\"Status changed from Investigating → Fixing\",\"type\":\"incident_update\"},{\"content\":{\"incident_update\":{\"id\":\"01JK20X1TA9122MBMB40PZCY3Y\",\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"new_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"previous_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"previous_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.039Z\",\"description\":\"Something has gone wrong, and we know why. We're in the process of fixing it.\",\"id\":\"01J94GJXNJ92K7SRTCH1QV7EQX\",\"name\":\"Fixing