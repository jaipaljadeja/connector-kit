            }
          },
          "response": {
            "status": 200,
            "body": "{\"incident_updates\":[{\"created_at\":\"2025-02-15T15:34:02.362Z\",\"id\":\"01JM53XJQGKSY6J8GSHCKCXVRZ\",\"incident_id\":\"01JM53HM15N4C003H0RS0J3TTF\",\"message\":\"Caused by node update.\",\"new_incident_status\":{\"category\":\"closed\",\"created_at\":\"2024-10-01T17:03:30.056Z\",\"description\":\"We're confident the issue is resolved.\",\"id\":\"01J94GJXNJDMYW28521QNQFMFC\",\"name\":\"Closed\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.056Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\"slack_user_id\":\"U04QJMRHM6W\"}}},{\"created_at\":\"2025-02-15T15:28:03.005Z\",\"id\":\"01JM53JKTPYTHXYTCXATFYXPJH\",\"incident_id\":\"01JM53HM15N4C003H0RS0J3TTF\",\"new_incident_status\":{\"category\":\"live\",\"created_at\":\"2024-10-01T17:03:30.034Z\",\"description\":\"We've spotted that something is wrong, but we're not quite sure why yet.\",\"id\":\"01J94GJXNJ522RJB36TTZAG4NR\",\"name\":\"Investigating\",\"rank\":1,\"updated_at\":\"2024-10-01T17:03:30.034Z\"},\"new_severity\":{\"created_at\":\"2024-10-01T17:03:29.979Z\",\"description\":\"Issues with low impact, which can usually be handled within working hours. Most customers are unlikely to notice any problems. Examples include a slight drop in application performance.\",\"id\":\"01J94GJXNJERC9ZSEXFVP9XEV8\",\"name\":\"Minor\",\"rank\":0,\"updated_at\":\"2024-10-01T17:03:29.979Z\"},\"updater\":{\"user\":{\"email\":\"francesco@apibara.com\",\"id\":\"01J94GJYMYR516X31X5K2Q5QKE\",\"name\":\"Francesco\",\"role\":\"responder\",\